# FinTrack environment variables
#
# The app runs with NONE of these set — every integration below is feature-flagged
# in lib/env.ts and stays disabled until its credential is present. Copy this file
# to .env.local and fill in only the phase you're working on.

# --- Persistence (MongoDB Atlas) --------------------------------------------
# Enables: real data instead of the in-memory seed in lib/mock-data.ts
MONGODB_URI=
MONGODB_DB=fintrack

# --- Authentication (Auth.js) -----------------------------------------------
# Enables: real sign-in/sign-up, sessions, protected server routes
# Generate a secret with: npx auth secret
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Optional OAuth provider
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Transactional email (Resend) -------------------------------------------
# Enables: invites, password resets, reminder digests
RESEND_API_KEY=
EMAIL_FROM=

# --- AI insights ------------------------------------------------------------
# Enables: model-written narratives on top of the locally-computed insights
ANTHROPIC_API_KEY=

# --- File storage (Vercel Blob) ---------------------------------------------
# Enables: receipt attachments, generated exports
BLOB_READ_WRITE_TOKEN=

# --- Observability (Sentry) -------------------------------------------------
SENTRY_DSN=
