# FinTrack environment variables
#
# The app runs with NONE of these set — every integration below is feature-flagged
# in lib/env.ts and stays disabled until its credential is present. Copy this file
# to .env.local and fill in only the phase you're working on.

# --- Authentication (Auth.js) — REQUIRED ------------------------------------
# Sign-in works without a database (against the seeded in-memory users), but
# it always needs a secret to sign session tokens.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# --- Persistence (MongoDB Atlas) --------------------------------------------
# Leave blank to use the in-memory store (data resets when the server restarts).
# Set it to persist real data:
#   1. Create a free M0 cluster at https://cloud.mongodb.com
#   2. Database Access  -> add a user with "Read and write to any database"
#   3. Network Access   -> allowlist your IP
#   4. Connect -> Drivers -> copy the connection string below
#   5. npm run db:check   (verify the connection)
#   6. npm run seed       (load the demo data)
# URL-encode special characters in the password: @ -> %40, # -> %23, / -> %2F
MONGODB_URI=
MONGODB_DB=fintrack

# Optional OAuth provider — additive; email+password keeps working without it
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Transactional email (Resend) -------------------------------------------
# Enables: invites, password resets, reminder digests
RESEND_API_KEY=
EMAIL_FROM=

# --- AI insights (open-weight models) ---------------------------------------
# Enables: a model-written paragraph on top of the locally-computed figures.
# Any OpenAI-compatible /chat/completions server works. The numbers are always
# computed locally — the model only writes prose over them, and any answer
# containing a figure that wasn't supplied is discarded.
#
# Local, free, no key (install from ollama.com, then `ollama pull llama3.2`):
#   AI_BASE_URL=http://localhost:11434/v1
#   AI_MODEL=llama3.2
#
# Groq — free tier, very fast, needs a free key from console.groq.com:
#   AI_BASE_URL=https://api.groq.com/openai/v1
#   AI_MODEL=llama-3.3-70b-versatile
#   AI_API_KEY=gsk_...
#
# OpenRouter — free tier, models suffixed `:free`, key from openrouter.ai:
#   AI_BASE_URL=https://openrouter.ai/api/v1
#   AI_MODEL=meta-llama/llama-3.3-70b-instruct:free
#   AI_API_KEY=sk-or-...
#
# Leave blank to keep the deterministic insights only.
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=

# --- Scheduled jobs ---------------------------------------------------------
# Bearer token Vercel Cron presents to /api/cron/*. Without it the recurring
# job refuses to run rather than running unauthenticated.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# On Vercel set this in Project Settings -> Environment Variables; the schedule
# itself lives in vercel.json.
CRON_SECRET=

# --- File storage (Vercel Blob) ---------------------------------------------
# Enables: receipt attachments, generated exports
BLOB_READ_WRITE_TOKEN=

# --- Observability (Sentry) -------------------------------------------------
SENTRY_DSN=
