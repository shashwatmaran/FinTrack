# FinTrack environment variables
#
# The app runs with NONE of these set — every integration below is feature-flagged
# in lib/env.ts and stays disabled until its credential is present. Copy this file
# to .env.local and fill in only the phase you're working on.

# --- Authentication (Auth.js) — REQUIRED ------------------------------------
# Sign-in works without a database (against the seeded in-memory users), but
# it always needs a secret to sign session tokens.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# --- Persistence (MongoDB Atlas) --------------------------------------------
# Leave blank to use the in-memory store (data resets when the server restarts).
# Set it to persist real data:
#   1. Create a free M0 cluster at https://cloud.mongodb.com
#   2. Database Access  -> add a user with "Read and write to any database"
#   3. Network Access   -> allowlist your IP
#   4. Connect -> Drivers -> copy the connection string below
#   5. npm run db:check   (verify the connection)
#   6. npm run seed       (load the demo data)
# URL-encode special characters in the password: @ -> %40, # -> %23, / -> %2F
#
# If `npm run db:check` fails with querySrv ECONNREFUSED / ENOTFOUND while the
# rest of your network is fine, it is DNS, not the IP allowlist — an
# un-allowlisted IP times out *after* resolving. mongodb+srv:// needs an SRV and
# a TXT lookup, and the driver makes those through Node's c-ares resolver, which
# has its own nameserver list. Ordinary hostname resolution goes through the OS
# instead, so everything else keeps working. Check with:
#   node -e "console.log(require('dns').getServers())"
# 127.0.0.1 with nothing listening on :53 means c-ares found no nameserver and
# fell back — even though Windows itself reports one. Seen with c-ares 1.34.6 on
# a machine whose only DNS server arrives via DHCP (no static NameServer set).
# Setting a static DNS server on the active adapter is worth trying (needs admin).
# Either fix the resolver, or use the direct (seed-list) string, which skips the
# SRV/TXT lookups entirely — Atlas offers it under Connect -> Drivers -> "Node.js
# 2.2.12 or later". It is not topology-proof, so prefer +srv when DNS is healthy:
#   mongodb://user:pass@host-00:27017,host-01:27017,host-02:27017/?ssl=true&replicaSet=<rs>&authSource=admin
MONGODB_URI=
MONGODB_DB=fintrack

# Optional OAuth provider — additive; email+password keeps working without it
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Transactional email (Resend) -------------------------------------------
# Enables the settlement-request email: the one notification that needs the
# recipient to act, and that blocks someone else's balance until they do.
# Everything else stays in the in-app feed.
#
# EMAIL_FROM is the address mail is sent *from*. Without a verified domain that
# has to be Resend's shared sender, and it must be a bare address — lib/env.ts
# validates it with z.string().email(), which rejects "FinTrack <...>".
#
#   EMAIL_FROM=onboarding@resend.dev
#
# The catch: until you verify a domain (Resend -> Domains -> two DNS records),
# Resend only delivers to the address the account was created with. Every other
# recipient comes back 403, which reads as "email is broken" until you know it
# is a domain step. lib/server/email.ts names that case in the log.
RESEND_API_KEY=
EMAIL_FROM=

# --- AI insights (open-weight models) ---------------------------------------
# Enables: a model-written paragraph on top of the locally-computed figures.
# Any OpenAI-compatible /chat/completions server works. The numbers are always
# computed locally — the model only writes prose over them, and any answer
# containing a figure that wasn't supplied is discarded.
#
# Local, free, no key (install from ollama.com, then `ollama pull llama3.2`):
#   AI_BASE_URL=http://localhost:11434/v1
#   AI_MODEL=llama3.2
#
# Groq — free tier, very fast, needs a free key from console.groq.com:
#   AI_BASE_URL=https://api.groq.com/openai/v1
#   AI_MODEL=llama-3.3-70b-versatile
#   AI_API_KEY=gsk_...
#
# OpenRouter — free tier, models suffixed `:free`, key from openrouter.ai:
#   AI_BASE_URL=https://openrouter.ai/api/v1
#   AI_MODEL=meta-llama/llama-3.3-70b-instruct:free
#   AI_API_KEY=sk-or-...
#
# Leave blank to keep the deterministic insights only.
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=

# --- Scheduled jobs ---------------------------------------------------------
# Bearer token Vercel Cron presents to /api/cron/*. Without it the recurring
# job refuses to run rather than running unauthenticated.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# On Vercel set this in Project Settings -> Environment Variables; the schedule
# itself lives in vercel.json.
CRON_SECRET=

# --- File storage (Vercel Blob) ---------------------------------------------
# Enables: receipt attachments, generated exports
BLOB_READ_WRITE_TOKEN=

# --- Observability (Sentry) -------------------------------------------------
# Enables crash reporting for the server, the edge and the browser. Without it
# an error boundary shows a digest hash and the stack only reaches the platform
# logs.
#
# Both names hold the same value. Only NEXT_PUBLIC_* is inlined into the client
# bundle, and the DSN is designed to be public — it permits writing events, not
# reading them. The token that could read your issues is SENTRY_AUTH_TOKEN,
# which is only used to upload source maps at build time and is optional.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Optional: uploads source maps so stack traces are not minified.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Shared rate limiting (Upstash Redis) -----------------------------------
# Without these the limiter keeps counters in process memory, which on
# serverless means one bucket per instance — real protection against a
# single-source flood, but not an exact ceiling. With them the count is shared,
# and if Redis is unreachable the limiter falls back to the in-process counters
# rather than locking everyone out of sign-in.
#
# Vercel -> Storage -> Create Database -> Upstash Redis provisions these and
# injects them into the deployment. Only these two are read; the rest are what
# Vercel writes alongside them.
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
KV_URL=
REDIS_URL=