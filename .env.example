# FinTrack environment variables
#
# The app runs with NONE of these set — every integration below is feature-flagged
# in lib/env.ts and stays disabled until its credential is present. Copy this file
# to .env.local and fill in only the phase you're working on.

# --- Authentication (Auth.js) — REQUIRED ------------------------------------
# Sign-in works without a database (against the seeded in-memory users), but
# it always needs a secret to sign session tokens.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# --- Persistence (MongoDB Atlas) --------------------------------------------
# Leave blank to use the in-memory store (data resets when the server restarts).
# Set it to persist real data:
#   1. Create a free M0 cluster at https://cloud.mongodb.com
#   2. Database Access  -> add a user with "Read and write to any database"
#   3. Network Access   -> allowlist your IP
#   4. Connect -> Drivers -> copy the connection string below
#   5. npm run db:check   (verify the connection)
#   6. npm run seed       (load the demo data)
# URL-encode special characters in the password: @ -> %40, # -> %23, / -> %2F
MONGODB_URI=
MONGODB_DB=fintrack

# Optional OAuth provider — additive; email+password keeps working without it
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Transactional email (Resend) -------------------------------------------
# Enables: invites, password resets, reminder digests
RESEND_API_KEY=
EMAIL_FROM=

# --- AI insights ------------------------------------------------------------
# Enables: model-written narratives on top of the locally-computed insights
ANTHROPIC_API_KEY=

# --- File storage (Vercel Blob) ---------------------------------------------
# Enables: receipt attachments, generated exports
BLOB_READ_WRITE_TOKEN=

# --- Observability (Sentry) -------------------------------------------------
SENTRY_DSN=
